{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "bun install --frozen-lockfile",
      "buildCommand": "bun run build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "LEARNHOUSE_API_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "app.py"
    },
    "collab": {
      "root": "apps/collab",
      "runtime": "container",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "LEARNHOUSE_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/content/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/collab",
      "destination": { "service": "collab" }
    },
    {
      "source": "/collab/(.*)",
      "destination": { "service": "collab" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
